# ============================================================
# SproutTales 环境变量样例
# 复制为 .env.local 后填写；生产环境在 Vercel Project Settings 里配置。
# 「必填」= 缺失会导致该功能直接不可用/报错。
# ============================================================

# ---------- 基础 ----------
# 必填。Neon Postgres 连接串（postgresql://...?sslmode=require）
NEON_DATABASE_URL=

# 必填（生产）。站点根地址，用于 OAuth 回调、邮件里的绝对链接、canonical
# 生产必须写成 https://your-domain.com，本地留空则回退 localhost:3000
SITE_URL=

# 必填。OpenRouter API Key（故事生成 / 角色卡 / 风格卡 / 生图）
OPENROUTER_API_KEY=

# ---------- 后台管理 ----------
# 必填（否则 /admin 一律 404）。允许访问后台的邮箱，逗号分隔
# 必须是能通过 Google 登录的邮箱，登录后才会命中白名单
ADMIN_EMAILS=

# ---------- 人机校验（Cloudflare Turnstile）----------
# 生产必填。缺失时生产环境的所有生成接口都会拒绝（fail-closed）
TURNSTILE_SECRET_KEY=
# 前端 sitekey；缺失时回退到 Cloudflare 的测试 key（仅本地开发）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- 登录（Google OAuth）----------
# 必填。Google Cloud Console → OAuth Client
# 授权回调地址：${SITE_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- 对象存储（Cloudflare R2）----------
# 可选。未配置时图片只以 base64 返回，不落对象存储（PDF/分享链路会变慢）
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=bookbunny
# 可选。自定义 CDN 域名；留空则走同源代理 /api/assets/*
R2_PUBLIC_URL=

# ---------- 支付：Waffo（当前线上主用）----------
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# 生产必须显式设为 false，否则会走测试环境收款
WAFFO_TEST_MODE=false
WAFFO_STARTER_MONTHLY_PRODUCT_ID=
WAFFO_STARTER_ANNUAL_PRODUCT_ID=
WAFFO_CREATOR_MONTHLY_PRODUCT_ID=
WAFFO_CREATOR_ANNUAL_PRODUCT_ID=
WAFFO_STUDIO_MONTHLY_PRODUCT_ID=
WAFFO_STUDIO_ANNUAL_PRODUCT_ID=
WAFFO_CREDITS_PRODUCT_ID=

# ---------- 支付：Creem（旧通道，可留空）----------
CREEM_API_KEY=
CREEM_TEST_MODE=false
CREEM_WEBHOOK_SECRET=
CREEM_PRO_PRODUCT_ID=
CREEM_COMMERCIAL_PRODUCT_ID=
# 家长同意（VPC）验证收费产品
CREEM_VPC_PRODUCT_ID=

# ---------- 邮件（Resend）----------
RESEND_API_KEY=
# 必须已在 Resend 验证过的发件域名
EMAIL_FROM=noreply@sprouttales.com

# ---------- 定时任务 ----------
# /api/cron/daily-digest 的 ?token= 校验值，留空则不校验（生产必须设置）
CRON_SECRET=

# ---------- 可选：运营与法务 ----------
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CRISP_WEBSITE_ID=
# 出现在隐私政策 / 服务条款里的主体信息
LEGAL_ENTITY=SproutTales
LEGAL_CONTACT_EMAIL=privacy@sprouttales.com
LEGAL_JURISDICTION=the People's Republic of China
